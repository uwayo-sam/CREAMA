# CREAMA Coffee Shop - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===========================================
# BACKEND CONFIGURATION (backend/.env)
# ===========================================

# Database Configuration
DB_HOST=localhost
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=creama_coffee

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production_make_it_long_and_random

# Server Configuration
PORT=5000

# ===========================================
# FRONTEND CONFIGURATION (frontend/.env)
# ===========================================

# API Base URL (should match backend PORT)
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: Frontend development server port
# PORT=3000

# ===========================================
# DEVELOPMENT NOTES
# ===========================================

# 1. Database Setup:
#    - Install MySQL Server
#    - Create database: creama_coffee
#    - Run backend/database.sql to create tables

# 2. JWT Secret:
#    - Generate a strong random string for production
#    - Keep it secret and don't commit to version control

# 3. Ports:
#    - Backend runs on port 5000 by default
#    - Frontend runs on port 3000 by default
#    - Make sure these ports are available

# 4. Security:
#    - Never commit actual .env files to version control
#    - Use strong passwords for database
#    - Change JWT secret in production